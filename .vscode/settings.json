{
  "// 说明": "团队统一编辑器行为，避免 Windows / macOS 之间换行与编码打架",
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": true,
  "editor.rulers": [100, 120],
  "editor.tabSize": 2,
  "[python]": {
    "editor.tabSize": 4
  },
  "[go]": {
    "editor.insertSpaces": false
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.venv": true
  }
}
