# 《真相局》环境变量样例 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。

# ---- 前端（Vite）----
# Mock 优先：true 走 src/api 的 Mock 适配器（localStorage 持久化），false 走真实 HTTP / Express
VITE_USE_MOCK=true
# 演示兜底：true 时房主可见「演示推进」按钮（强制下一幕/结束，需二次确认）
VITE_DEMO_MODE=false

# ---- 后端（Express）----
PORT=3001

# 房间/玩家/投票的落盘位置（默认 .data/rooms.json，已 gitignore）
STORE_FILE=
# 剧本数据目录（默认 data/scripts）
SCRIPTS_DIR=

# 说明：剧本内容不入库，前后端都直接读 data/scripts/*.json。
# DATABASE_URL 目前只在启用 Prisma 迁移时才需要，见 README 3.6。
# 注意：SQLite 的相对路径是相对 **prisma/schema.prisma** 所在目录解析的，
# 写成 file:./prisma/dev.db 会落到 prisma/prisma/dev.db（已踩过）。
DATABASE_URL="file:./dev.db"

# ---- AI（OpenAI，服务端调用）----
# 无 Key 时 POST /api/ai/hint 自动降级为 Mock，不影响演示
OPENAI_API_KEY=
# 走代理/兼容网关时填，例如 https://xxx/v1
OPENAI_BASE_URL=
# 默认 gpt-4o-mini
OPENAI_MODEL=
AI_TIMEOUT_MS=8000
