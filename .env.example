# 《真相局》环境变量样例 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。

# ---- 前端（Vite）----
# Mock 优先：true 走 src/api 的 Mock 适配器（localStorage 持久化），false 走真实 HTTP / Express
VITE_USE_MOCK=true
# 演示兜底：true 时房主可见「演示推进」按钮（强制下一幕/结束，需二次确认）
VITE_DEMO_MODE=false

# ---- 后端（Express）----
PORT=3001
# 本地 Demo 用 SQLite；部署切 PostgreSQL 时改这里
DATABASE_URL="file:./prisma/dev.db"

# ---- AI（OpenAI，服务端调用）----
# 无 Key 时 POST /api/ai/hint 自动降级为 Mock，不影响演示
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AI_TIMEOUT_MS=8000
