# 环境变量样例 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。
# 提交前请确认 scripts/check-repo.sh 的密钥扫描通过。

# ---- 运行环境 ----
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# ---- 大模型 / 第三方 API ----
# 若赛题要求不得外传数据，请把调用改为本地模型或 Mock
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=replace-me

# ---- 数据存储 ----
DATABASE_URL=postgresql://user:password@localhost:5432/hackathon
REDIS_URL=redis://localhost:6379/0

# ---- 对象存储（演示用，可留空）----
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- 前端公开变量（会被打包进产物，禁止放密钥）----
PUBLIC_API_BASE=http://localhost:3000
